# Пример переменных окружения для АИСПВИ (скопируйте в .env и подставьте свои значения)
#
# Рабочая база проекта — myfin (создана в pgAdmin). В конце DATABASE_URL всегда /myfin.
# Формат SQLAlchemy 2 + драйвер psycopg 3:
#   postgresql+psycopg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
#
# Вариант 1 — подключение под суперпользователем postgres (пароль тот, что задали при установке PostgreSQL):
# DATABASE_URL=postgresql+psycopg://postgres:ВАШ_ПАРОЛЬ@127.0.0.1:5432/myfin
#
# Вариант 2 — отдельный пользователь aispvi (создаётся скриптом scripts/postgres_setup_myfin.sql, вариант A):
DATABASE_URL=postgresql+psycopg://aispvi:secret@127.0.0.1:5432/myfin
#
# Для пароля со спецсимволами используйте URL-кодирование (например @ -> %40).
#
-- Добавление колонок для синхронизации с внешними API (если таблица deposits уже создана без них).
# Резервный вариант для быстрых тестов без PostgreSQL:
# DATABASE_URL=sqlite:///./aispvi.db
#
# Справочные вклады USD/EUR (в публичном API Беларусбанка по валюте часто нет осмысленной числовой ставки):
# ADD_REFERENCE_USD_EUR_CATALOG=true
# REFERENCE_FX_BANK_NAME=Ориентир USD/EUR
# REFERENCE_USD_NOMINAL_RATE_PERCENT=3.5
# REFERENCE_EUR_NOMINAL_RATE_PERCENT=3.0
